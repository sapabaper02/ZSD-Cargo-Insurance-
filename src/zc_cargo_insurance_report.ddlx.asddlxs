@Metadata.layer: #CORE
@UI: {
    headerInfo: { typeName: 'Cargo Insurance',
                typeNamePlural: 'Cargo Insurances',
                title: { type: #STANDARD, label: 'Cargo Insurance', value: 'Companycode' } }
}
annotate entity ZC_CARGO_INSURANCE_REPORT with
{
  @UI.facet: [ { id:       'Insurance',
           purpose:         #STANDARD,
           type:            #IDENTIFICATION_REFERENCE,
           label:           'Cargo Insurance Details',
           position:        10 }
          ]

